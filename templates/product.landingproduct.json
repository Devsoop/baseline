    "faq_with_image_YCCtz3": {
      "type": "faq-with-image",
      "blocks": {
        "faq_item_KnYf4P": {
          "type": "faq_item",
          "settings": {
            "question": "What makes baseline different from other olive oils?",
            "answer": "<p>baseline is a high-polyphenol extra virgin olive oil that's lab-tested by batch. We guarantee at least 400 mg/kg of polyphenols – compounds linked to a range of health benefits. Every bottle is traceable and verified with a QR code.</p>"
          }
        },
        "faq_item_EeJADL": {
          "type": "faq_item",
          "settings": {
            "question": "What are polyphenols and why do they matter?",
            "answer": "<p>Polyphenols are naturally occurring antioxidants found in olive oil. High concentrations are associated many different health benefits. Most commercial olive oils lose polyphenols during processing – we preserve them.</p>"
          }
        },
        "faq_item_LQpzEF": {
          "type": "faq_item",
          "settings": {
            "question": "What does it taste like?",
            "answer": "<p>Our olive oil has a robust, peppery finish with fresh grassy notes – a sign of high polyphenol content. It's bold and complex, unlike refined or blended oils.</p>"
          }
        },
        "faq_item_78cK4H": {
          "type": "faq_item",
          "settings": {
            "question": "Is baseline suitable for cooking?",
            "answer": "<p>While you can cook with it, we recommend using it raw (e.g., drizzled or taken directly) to preserve its full nutritional value and antioxidant content.</p>"
          }
        },
        "faq_item_Vn93hf": {
          "type": "faq_item",
          "settings": {
            "question": "Is it organic?",
            "answer": "<p>While baseline isn’t certified organic <em>yet</em>, we source oils from producers that believe in natural cultivation without the use of  pesticides or chemical fertilizers. We’re actively working toward formal organic certification.</p>"
          }
        },
        "faq_item_bzGjbA": {
          "type": "faq_item",
          "settings": {
            "question": "How should I take it?",
            "answer": "<p>Many customers take 1–2 tablespoons daily, straight or drizzled on food. There's no strict rule – use it however suits your lifestyle.</p>"
          }
        },
        "faq_item_UPTfiV": {
          "type": "faq_item",
          "settings": {
            "question": "When will my order arrive?",
            "answer": "<p>Orders typically dispatch within 1–2 business days. Delivery times depend on your location – standard shipping is 2 business days.</p>"
          }
        }
      },

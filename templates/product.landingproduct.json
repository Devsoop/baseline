        },
        "testimonials_nTMy8t": {
          "type": "testimonials",
          "settings": {
            "stars_count": 5,
            "heading": "My skin actually looks healthier",
            "text": "I bought this mostly for gut health, but after a few weeks my skin started looking clearer and more hydrated. A friend actually asked me if I changed my skincare routine which I didn’t. Only thing I added was this.",
            "author_date": "Cathrine R"
          }
        },
        "testimonials_nnAM6F": {
          "type": "testimonials",
          "settings": {
            "stars_count": 5,
            "heading": "Didn’t realize olive oil could be this different",
            "text": "I’ve used olive oil my whole life, but this is on another level. The taste is strong in a good way and you can tell it’s actually potent. After learning about the polyphenols and scanning the lab results, I honestly won’t go back to regular store oils.",
            "author_date": "George T"
          }
        },
        "testimonials_wdtXn6": {
          "type": "testimonials",
          "settings": {
            "stars_count": 5,
            "heading": "Feels more like a supplement than an olive oil",
            "text": "I originally bought Baseline out of curiosity but now I take a small shot every morning. It feels more like a health supplement than cooking oil. My gut feels calmer and I don’t get that heavy feeling after meals anymore.",
            "author_date": "Vivian E"
          }
        },
        "testimonials_wQ73Lf": {
          "type": "testimonials",
          "settings": {
            "stars_count": 5,
            "heading": "Didn’t realize how bad my digestion was before",
            "text": "I always thought feeling heavy or bloated after meals was normal. After taking Baseline daily for a couple weeks my stomach just feels calmer. Hard to explain but digestion definitely feels smoother.",
            "author_date": "Olivia B"
          }
        }
      },
